{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node10",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "outDir": ".test-build",
    "rootDir": ".",
    "skipLibCheck": true,
    "types": ["node"]
